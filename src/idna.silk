//! Regenerate the Unicode 18 IDNA table from digest-pinned sources.
//! `generate(false, false, true)` checks offline; fetch permits missing cache downloads;
//! update downloads both canonical URLs and publishes a new lock after formatting succeeds.

import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.hash { Hash }
import silk.collections.hash_map { HashMap }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.crypto.sha2 { Sha256 }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.usize
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { AtomicWriteError, FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.format { Format }
import silk.text.string { InvalidUtf8, String }

struct Source {
  text: String,
  resolved: String,
  sha256: String
}

struct Mapping {
  start: usize,
  length: usize,
  next: usize
}

impl Copy for Mapping {}

pub effect fn generate(fetch: bool, update: bool, check: bool) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  if fetch && update {
    run Task.abort("Choose --fetch or --update")
  }
  if update && check {
    run Task.abort("Choose --update or --check")
  }
  let root = run Task.root()
  let cache = run Path.join(&root, "modules/.cache/idna")
  run FileSystem.createDirectoriesRecursively(&cache)
  let staging = run FileSystem.temporaryDirectory(&cache, "svg-idna-")
  let outcome = run Effect.result(materialize(&root, &cache, &staging.path, fetch, update, check))
  run FileSystem.releaseIgnored(move staging)
  match move outcome {
    Result<
      (),
      TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    >.Success {
      ..
    } => ()
    Result<
      (),
      TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    >.Failure {
      error
    } => {
      fail move error
    }
  }
}

effect fn materialize(
  root: &Path,
  cache: &Path,
  stage: &Path,
  fetch: bool,
  update: bool,
  check: bool,
) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let lockPath = run Path.join(root, "modules/idna.lock.json")
  let lock = if update {
    Value.Null
  } else {
    run readLock(&lockPath)
  }
  let mapping = run source(
    "mapping",
    "https://www.unicode.org/Public/18.0.0/idna/IdnaMappingTable.txt",
    &lock,
    cache,
    stage,
    fetch,
    update,
  )
  let license = run source(
    "license",
    "https://www.unicode.org/license.txt",
    &lock,
    cache,
    stage,
    fetch,
    update,
  )
  let table = String.view(&mapping.text)
  let version = String.find(table, "# Version: 18.0.0")
  if !Option<usize>.isSome(&version) {
    run Task.abort("Mapping must match Unicode 18.0.0")
  }
  let mut rows = Bytes.make()
  let mut pool = Bytes.make()
  run parseMapping(table, &mut rows, &mut pool)
  let mut result = run Bytes.makeWithCapacity(
    (Bytes.length(&rows) + Bytes.length(&pool)) * 4 + String.byteLength(String.view(&license.text))
      + 2048,
  )
  run Bytes.append(
    &mut result,
    b"// Generated by silk task generate-idna. DO NOT EDIT.\n// Unicode18.0.0 UTS46; source hashes: modules/idna.lock.json.\n",
  )
  let legal = String.view(&license.text)
  let mut end = String.byteLength(legal)
  let legalBytes = String.utf8Bytes(legal)
  if end > 0 && legalBytes[end - 1] == 10 {
    end = end - 1
    if end > 0 && legalBytes[end - 1] == 13 {
      end = end - 1
    }
  }
  let mut lines = String.split(String.slice(legal, 0, end), "\n")
  let mut consumed: usize = 0
  while let Option<string>.Some { value: line } = lines.next() {
    let mut length = String.byteLength(line)
    let nextLine = consumed + length + 1
    if consumed + length < end && length > 0 && String.utf8Bytes(line)[length - 1] == 13 {
      length = length - 1
    }
    consumed = nextLine
    run Bytes.append(&mut result, b"// ")
    run Bytes.append(&mut result, String.utf8Bytes(String.slice(line, 0, length)))
    run Bytes.append(&mut result, b"\n")
  }
  run Bytes.append(&mut result, b"import silk.num.u8\nimport silk.num.u32\n\n")
  run literal(&mut result, "records", Bytes.asSlice(&rows))
  run Bytes.append(&mut result, b"\n")
  run literal(&mut result, "mappings", Bytes.asSlice(&pool))
  run Bytes.append(
    &mut result,
    b"\nfn word(bytes: &[u8], at: usize) -> u32 {\n  return u8.toU32(bytes[at]) | u32.shiftLeft(u8.toU32(bytes[at + 1]), 8)\n    | u32.shiftLeft(u8.toU32(bytes[at + 2]), 16)\n}\n\n// Returns a record offset; all scalar slots including unassigned are covered.\npub fn lookup(cp: u32) -> usize {\n  let data = records()\n  let mut low: usize = 0\n  let mut high = data.length / 8\n  while low + 1 < high {\n    let middle = low + (high - low) / 2\n    if word(data, middle * 8) <= cp { low = middle } else { high = middle }\n  }\n  return low * 8\n}\n\npub fn status(record: usize) -> u8 { return records()[record + 3] }\npub fn length(record: usize) -> usize { return u8.toUsize(records()[record + 7]) }\npub fn mapping(record: usize, index: usize) -> u32 {\n  return word(mappings(), (u32.toUsize(word(records(), record + 4)) + index) * 3)\n}\n",
  )
  let staged = run Path.join(stage, "url_idna_data.silk")
  run FileSystem.writeFile(&staged, Bytes.asSlice(&result))
  run Task.silk(&["format", run pathText(&staged)])
  let formatted = run FileSystem.readFile(&staged)
  let output = run Path.join(root, "modules/src/url_idna_data.silk")
  let same = if run FileSystem.exists(&output) {
    let old = run FileSystem.readFile(&output)
    equal(Bytes.asSlice(&old), Bytes.asSlice(&formatted))
  } else {
    false
  }
  if !same {
    if check {
      run Task.abort("Generated IDNA table differs; run silk task generate-idna --fetch")
    }
    run publish(&output, Bytes.asSlice(&formatted))
  }
  if update {
    let mut nextLock = run Bytes.copy(
      b"{\n  \"format\": 1,\n  \"unicode\": \"18.0.0\",\n  \"license\": \"Unicode-3.0\",\n  \"sources\": {\n",
    )
    run lockSource(
      &mut nextLock,
      "mapping",
      "https://www.unicode.org/Public/18.0.0/idna/IdnaMappingTable.txt",
      &mapping,
    )
    run Bytes.append(&mut nextLock, b",\n")
    run lockSource(&mut nextLock, "license", "https://www.unicode.org/license.txt", &license)
    run Bytes.append(&mut nextLock, b"\n  }\n}\n")
    run publish(&lockPath, Bytes.asSlice(&nextLock))
  }
  let mut message = run Bytes.copy(b"Materialized ")
  run decimal(&mut message, Bytes.length(&rows) / 8)
  run Bytes.append(&mut message, b" mapping records, ")
  run decimal(&mut message, Bytes.length(&pool) / 3)
  run Bytes.append(&mut message, b" mapping scalars\n")
  let mut stdout = StdoutWriter.make()
  run Writer.writeAll(Bytes.asSlice(&message)) |> Effect.provideMut<Writer>(&mut stdout)
}

effect fn readLock(path: &Path) -> Value
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let bytes = run FileSystem.readFile(path)
  let document = match move run Effect.result(Json.parse(Bytes.asSlice(&bytes))) {
    Result<Value, JsonError | OutOfMemoryError>.Success { value } => move value
    Result<Value, JsonError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError failure => {
        fail move failure
      }
      JsonError failure => {
        drop failure
        run Task.abort("Invalid IDNA lock")
      }
    }
  }
  let format = Json.asI32(Json.field(&document, "format")) |> Option<i32>.unwrapOr(0)
  let unicode = run textField(&document, "unicode")
  if format != 1 || unicode != "18.0.0" {
    run Task.abort("Invalid IDNA lock")
  }
  let sources = run field(&document, "sources")
  match &sources.* {
    Value.Object { entries } => {
      if List.length(&entries) != 2 {
        run Task.abort("Invalid IDNA lock")
      }
    }
    _ => run Task.abort("Invalid IDNA lock")
  }
  let _mapping = run field(sources, "mapping")
  let _license = run field(sources, "license")
  return move document
}

effect fn field<'a>(document: &'a Value, name: string) -> &'a Value
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  return match move Json.field(document, name) {
    Option<&'a Value>.Some { value } => value
    Option<&'a Value>.None => run Task.abort("Invalid IDNA lock")
  }
}

effect fn textField<'a>(document: &'a Value, name: string) -> string<'a>
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  return match move Json.asString(Json.field(document, name)) {
    Option<string<'a>>.Some { value } => value
    Option<string<'a>>.None => run Task.abort("Invalid IDNA lock")
  }
}

effect fn source(
  name: string,
  url: string,
  lock: &Value,
  cache: &Path,
  stage: &Path,
  fetch: bool,
  update: bool,
) -> Source
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let mut resolved = String.make()
  let mut pinned = String.make()
  if !update {
    let record = run field(run field(lock, "sources"), name)
    resolved = run String.copy(run textField(record, "resolved"))
    pinned = run String.copy(run textField(record, "sha256"))
    let digest = String.utf8Bytes(String.view(&pinned))
    if digest.length != 64 {
      run Task.abort("Invalid IDNA lock digest")
    }
    let mut at: usize = 0
    while at < digest.length {
      let byte = digest[at]
      if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) {
        run Task.abort("Invalid IDNA lock digest")
      }
      at = at + 1
    }
  }
  let mut bytes = Bytes.make()
  let mut cached = false
  if !update {
    let path = run Path.join(cache, String.view(&pinned))
    if run FileSystem.exists(&path) {
      bytes = run FileSystem.readFile(&path)
      cached = true
    }
  }
  if !cached {
    if !update && !fetch {
      let mut message = run String.copy("Missing ")
      run String.append(&mut message, name)
      run String.append(&mut message, " cache; use --fetch")
      run Task.abort(String.view(&message))
    }
    let download = run Path.join(stage, name)
    let requested = if update {
      url
    } else {
      String.view(&resolved)
    }
    let response = run Task.capture(
      "curl",
      &[
        "--fail",
        "--location",
        "--silent",
        "--show-error",
        "--max-time",
        "90",
        "--output",
        run pathText(&download),
        "--write-out",
        "%{url_effective}",
        "--url",
        requested,
      ],
    )
    bytes = run FileSystem.readFile(&download)
    if update {
      resolved = run utf8(move response)
    }
  }
  let hash = Sha256.hash(Bytes.asSlice(&bytes))
  let mut digestBytes = run Bytes.makeWithCapacity(64)
  run hexadecimal(&mut digestBytes, &hash, false)
  let digest = run utf8(move digestBytes)
  if update {
    pinned = move digest
  } else if String.view(&digest) != String.view(&pinned) {
    let mut message = run String.copy(name)
    run String.append(&mut message, ": pinned digest mismatch")
    run Task.abort(String.view(&message))
  }
  let destination = run Path.join(cache, String.view(&pinned))
  run publish(&destination, Bytes.asSlice(&bytes))
  let decoded = run utf8(move bytes)

  // TextDecoder's default UTF-8 BOM handling is part of the old generator's input contract.
  let decodedBytes = String.utf8Bytes(String.view(&decoded))
  let text = if decodedBytes.length >= 3 && decodedBytes[0] == 239 && decodedBytes[1] == 187
    && decodedBytes[2] == 191 {
    run String.copy(
      String.slice(String.view(&decoded), 3, String.byteLength(String.view(&decoded)) - 3),
    )
  } else {
    move decoded
  }
  return Source { text: move text, resolved: move resolved, sha256: move pinned }
}

effect fn parseMapping(table: string, rows: &mut Bytes, pool: &mut Bytes) -> ()
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let mut lines = String.split(table, "\n")
  let mut next: usize = 0
  let mut heads = HashMap<u64, usize>.make(Hash.seed(0))
  let mut mappings = List<Mapping>.make()
  let mut mapping = Bytes.make()
  while let Option<string>.Some { value: line } = lines.next() {
    let comment = String.find(line, "#") |> Option<usize>.unwrapOr(String.byteLength(line))
    let mut fields = String.split(String.slice(line, 0, comment), ";")
    let range = String.trim(fields.next() |> Option<string>.unwrapOr(""))
    if String.byteLength(range) == 0 {
      continue
    }
    let mut bounds = String.split(range, "..")
    let start = run codepoint(bounds.next() |> Option<string>.unwrapOr(""))
    let end = match move bounds.next() {
      Option<string>.Some { value } => run codepoint(value)
      Option<string>.None => start
    }
    if start != next || end < start {
      run Task.abort("Mapping ranges must cover Unicode contiguously")
    }
    next = end + 1
    let status = String.trim(fields.next() |> Option<string>.unwrapOr(""))
    let kind: u8 = if status == "valid" {
      0
    } else if status == "deviation" {
      1
    } else if status == "ignored" {
      2
    } else if status == "mapped" {
      3
    } else if status == "disallowed" {
      4
    } else {
      let mut message = run String.copy("Unknown IDNA status: ")
      run String.append(&mut message, status)
      run Task.abort(String.view(&message))
    }
    Bytes.clear(&mut mapping)
    if kind == 3 {
      let text = String.trim(fields.next() |> Option<string>.unwrapOr(""))
      let bytes = String.utf8Bytes(text)
      let mut at: usize = 0
      while at < bytes.length {
        while at < bytes.length && whitespace(bytes[at]) {
          at = at + 1
        }
        let first = at
        while at < bytes.length && !whitespace(bytes[at]) {
          at = at + 1
        }
        if first < at {
          if Bytes.length(&mapping) / 3 == 255 {
            run Task.abort("Mapping exceeds packed length")
          }
          run packed(&mut mapping, run codepoint(String.slice(text, first, at - first)))
        }
      }
    }
    let length = Bytes.length(&mapping)
    let mut hash: u64 = 0
    let mut at: usize = 0
    while at < length {
      hash = Hash.combine(hash, u8.toU64(Bytes.asSlice(&mapping)[at]))
      at = at + 1
    }
    let head = heads.get(hash) |> Option<usize>.unwrapOr(0)
    let mut node = head
    let mut offset = Bytes.length(&pool.*)
    let mut found = false
    while node != 0 {
      let entry = mappings.get(node - 1)
      if entry.length == length
        && equal(
          Slice.view<u8>(Bytes.asSlice(&pool.*), entry.start, length),
          Bytes.asSlice(&mapping),
        ) {
        offset = entry.start
        found = true
        break
      }
      node = entry.next
    }
    if !found {
      run mappings.append(Mapping { start: offset, length: length, next: head })
      let _previous = run heads.insert(hash, mappings.length())
      run Bytes.append(&mut pool, Bytes.asSlice(&mapping))
    }
    run packed(&mut rows, start)
    run Bytes.append(&mut rows, &[kind])
    run packed(&mut rows, offset / 3)
    run Bytes.append(&mut rows, &[usize.toU8(length / 3)])
  }
  if next != 0x110000 {
    run Task.abort("Incomplete mapping")
  }
}

fn whitespace(byte: u8) -> bool {
  return byte == 32 || (byte >= 9 && byte <= 13)
}

effect fn codepoint(text: string) -> usize
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(String.trim(text))
  if bytes.length == 0 {
    run Task.abort("Invalid IDNA code point")
  }
  let mut value: usize = 0
  let mut at: usize = 0
  while at < bytes.length {
    let byte = u8.toUsize(bytes[at])
    let digit = if byte >= 48 && byte <= 57 {
      byte - 48
    } else if byte >= 65 && byte <= 70 {
      byte - 55
    } else if byte >= 97 && byte <= 102 {
      byte - 87
    } else {
      run Task.abort("Invalid IDNA code point")
    }
    value = value * 16 + digit
    if value > 0x10ffff {
      run Task.abort("Invalid IDNA code point")
    }
    at = at + 1
  }
  return value
}

effect fn packed(out: &mut Bytes, value: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(
    &mut out,
    &[usize.toU8(value % 256), usize.toU8(value / 256 % 256), usize.toU8(value / 65536 % 256)],
  )
}

effect fn hexadecimal(out: &mut Bytes, bytes: &[u8], escaped: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let digits = b"0123456789abcdef"
  let mut at: usize = 0
  while at < bytes.length {
    let value = u8.toUsize(bytes[at])
    if escaped {
      run Bytes.append(&mut out, b"\\x")
    }
    run Bytes.append(&mut out, &[digits[value / 16], digits[value % 16]])
    at = at + 1
  }
}

effect fn literal(out: &mut Bytes, name: string, bytes: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(&mut out, b"fn ")
  run Bytes.append(&mut out, String.utf8Bytes(name))
  run Bytes.append(&mut out, b"() -> &'static [u8] {\n  return b\"")
  run hexadecimal(&mut out, bytes, true)
  run Bytes.append(&mut out, b"\"\n}\n")
}

effect fn lockSource(out: &mut Bytes, name: string, url: string, source: &Source) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(&mut out, b"    ")
  run quoted(&mut out, name)
  run Bytes.append(&mut out, b": {\n      \"url\": ")
  run quoted(&mut out, url)
  run Bytes.append(&mut out, b",\n      \"resolved\": ")
  run quoted(&mut out, String.view(&source.resolved))
  run Bytes.append(&mut out, b",\n      \"sha256\": ")
  run quoted(&mut out, String.view(&source.sha256))
  run Bytes.append(&mut out, b"\n    }")
}

effect fn quoted(out: &mut Bytes, text: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(&mut out, b"\"")
  let bytes = String.utf8Bytes(text)
  let mut at: usize = 0
  while at < bytes.length {
    let byte = bytes[at]
    match byte {
      34 => run Bytes.append(&mut out, b"\\\"")
      92 => run Bytes.append(&mut out, b"\\\\")
      8 => run Bytes.append(&mut out, b"\\b")
      9 => run Bytes.append(&mut out, b"\\t")
      10 => run Bytes.append(&mut out, b"\\n")
      12 => run Bytes.append(&mut out, b"\\f")
      13 => run Bytes.append(&mut out, b"\\r")
      _ => {
        if byte < 32 {
          run Bytes.append(&mut out, b"\\u00")
          run hexadecimal(&mut out, &[byte], false)
        } else {
          run Bytes.append(&mut out, &[byte])
        }
      }
    }
    at = at + 1
  }
  run Bytes.append(&mut out, b"\"")
}

effect fn decimal(out: &mut Bytes, value: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut buffer: [u8; 20] = [0; 20]
  let length = Format.writeU64Display(usize.toU64(value), &mut buffer, 0)
  run Bytes.append(&mut out, Slice.view<u8>(&buffer, 0, length))
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}

effect fn utf8(bytes: Bytes) -> String
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  return match move String.fromBytes(move bytes) {
    Result<String, InvalidUtf8>.Success { value } => move value
    Result<String, InvalidUtf8>.Failure { .. } => run Task.abort("IDNA source is not valid UTF-8")
  }
}

effect fn pathText(path: &Path) -> string
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  return match move Path.view(path) {
    Option<string>.Some { value } => value
    Option<string>.None => run Task.abort("IDNA path is not valid UTF-8")
  }
}

effect fn publish(path: &Path, bytes: &[u8]) -> ()
  ! TaskError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  match move run Effect.result(
    FileSystem.writeFileAtomic(path, bytes, FileSystem.replaceExisting(), FileSystem.buffered()),
  ) {
    Result<(), AtomicWriteError>.Success { .. } => ()
    Result<(), AtomicWriteError>.Failure { .. } => run Task.abort(
      "Could not atomically publish IDNA file",
    )
  }
}
