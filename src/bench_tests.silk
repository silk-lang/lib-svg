//! Ported benchmark invariants. Native process fixtures are injected at ChildProcess,
//! never implemented by a shell/JavaScript/Python helper executable.
import bench { Common }
import bench_support as B
import task_support as Support
import bench_geometry as G
import bench_harness as H
import bench_workloads as W
import bench_images as Images
import fixtures_common as F
