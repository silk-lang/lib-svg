//! Prepares exact generated bytes and authenticates both downloaded and normalized Tiger.
import bench_support as B
import bench_geometry as Geometry
import bench_process as Process
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.crypto.sha2 { Sha256 }
import silk.io.writer { WriterError }
import silk.json.value { Json, Value }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import silk.xml.document { XmlDocument, XmlNodeId, XmlNodeKind, XmlError }
import silk.num.u64
import silk.num.usize

pub struct Workload {
  pub name: String,
  pub files: List<Path>,
  pub bytes: usize,
  pub sha256: String
}

struct Namespace {
  uri: String,
  prefix: String
}

effect fn register(names: &mut List<Namespace>, uri: string) -> ()
  ! TaskError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  if uri == "" || uri == "http://www.w3.org/XML/1998/namespace"
    || uri == "http://www.w3.org/2000/xmlns/" {
    return
  }
  let mut i: usize = 0
  while i < names.length() {
    if String.view(&names.asSlice()[i].uri) == uri {
      return
    }
    i = i + 1
  }
  let prefix = if uri == "http://www.w3.org/2000/svg" {
    String.make()
  } else {
    run B.format("ns{index}", &.{ index: names.length() })
  }
  run names.append(Namespace { uri: run String.copy(uri), prefix: move prefix })
}

effect fn qualified(names: &[Namespace], uri: string, local: string) -> String
  ! TaskError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  if uri == "" || uri == "http://www.w3.org/2000/svg" {
    return run String.copy(local)
  }
  if uri == "http://www.w3.org/XML/1998/namespace" {
    return run B.format("xml:{local}", &.{ local: local })
  }
  let mut i: usize = 0
  while i < names.length {
    if String.view(&names[i].uri) == uri {
      return run B.format(
        "{prefix}:{local}",
        &.{ prefix: String.view(&names[i].prefix), local: local },
      )
    }
    i = i + 1
  }
  run Task.abort("unregistered XML namespace")
}

effect fn escaped(out: &mut String, text: string, attribute: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut start: usize = 0
  let mut i: usize = 0
  while i < bytes.length {
    let replacement = if bytes[i] == 38 {
      "&amp;"
    } else if bytes[i] == 60 {
      "&lt;"
    } else if bytes[i] == 62 {
      "&gt;"
    } else if attribute && bytes[i] == 34 {
      "&quot;"
    } else if attribute && bytes[i] == 9 {
      "&#09;"
    } else if attribute && bytes[i] == 10 {
      "&#10;"
    } else if attribute && bytes[i] == 13 {
      "&#13;"
    } else {
      ""
    }
    if replacement != "" {
      run out.append(unsafe String.fromUtf8Unchecked(Slice.view(bytes, start, i - start)))
      run out.append(replacement)
      start = i + 1
    }
    i = i + 1
  }
  run out.append(unsafe String.fromUtf8Unchecked(Slice.view(bytes, start, bytes.length - start)))
}

effect fn serialize(
  document: &XmlDocument,
  id: XmlNodeId,
  names: &[Namespace],
  root: bool,
  out: &mut String,
) -> ()
  ! TaskError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  let tag = run qualified(names, document.namespaceUri(id), document.localName(id))
  run out.append("<")
  run out.append(String.view(&tag))
  if root {
    // Prefixes are emitted lexicographically, including ns10 before ns2.
    let mut order = List<usize>.make()
    let mut i: usize = 0
    while i < names.length {
      run order.append(i)
      i = i + 1
    }
    i = 1
    while i < order.length() {
      let mut j = i
      while j > 0
        && B.before(
          String.view(&names[order.asSlice()[j]].prefix),
          String.view(&names[order.asSlice()[j - 1]].prefix),
        ) {
        let previous = order.asSlice()[j - 1]
        let current = order.asSlice()[j]
        order.set(j - 1, current)
        order.set(j, previous)
        j = j - 1
      }
      i = i + 1
    }
    i = 0
    while i < order.length() {
      let namespace = &names[order.asSlice()[i]]
      run out.append(" xmlns")
      if String.view(&namespace.prefix) != "" {
        run out.append(":")
        run out.append(String.view(&namespace.prefix))
      }
      run out.append("=\"")
      run escaped(&mut out, String.view(&namespace.uri), true)
      run out.append("\"")
      i = i + 1
    }
  }
  let attributes = document.attributes(id)
  let mut i: usize = 0
  while i < attributes.length {
    let attribute = attributes[i]
    let uri = document.attributeNamespaceUri(attribute)
    if uri != "http://www.w3.org/2000/xmlns/" {
      let name = run qualified(names, uri, document.attributeLocalName(attribute))
      run out.append(" ")
      run out.append(String.view(&name))
      run out.append("=\"")
      run escaped(&mut out, document.attributeValue(attribute), true)
      run out.append("\"")
    }
    i = i + 1
  }
  let mut child = document.firstChild(id)
  let mut hasChildren = false
  while let Option<XmlNodeId>.Some { value } = child {
    if document.kind(value) == XmlNodeKind.Element || document.kind(value) == XmlNodeKind.Text {
      hasChildren = true
      break
    }
    child = document.nextSibling(value)
  }
  if !hasChildren {
    run out.append(" />")
    return
  }
  run out.append(">")
  child = document.firstChild(id)
  while let Option<XmlNodeId>.Some { value } = child {
    if document.kind(value) == XmlNodeKind.Element {
      run serialize(document, value, names, false, &mut out)
    } else if document.kind(value) == XmlNodeKind.Text {
      run escaped(&mut out, document.text(value), false)
    }
    child = document.nextSibling(value)
  }
  run out.append("</")
  run out.append(String.view(&tag))
  run out.append(">")
}

pub effect fn normalizeTiger(data: &[u8], config: &Value) -> Bytes
  ! TaskError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut document = match move run Effect.result(XmlDocument.parse(data)) {
    Result<XmlDocument, XmlError | OutOfMemoryError>.Success { value } => move value
    Result<XmlDocument, XmlError | OutOfMemoryError>.Failure {
      error: failure
    } => match move failure {
      OutOfMemoryError error => {
        fail move error
      }
      XmlError error => {
        drop error
        run Task.abort("invalid Tiger XML")
      }
    }
  }
  let root = document.root()
  let viewbox = document.attribute(root, "", "viewBox") |> Option<string>.unwrapOr("")
  if document.namespaceUri(root) != "http://www.w3.org/2000/svg"
    || document.localName(root) != "svg"
    || viewbox != run B.str(run B.field(config, "viewBox")) {
    run Task.abort("Tiger viewport normalization requires the pinned SVG viewBox")
  }
  let width = run B.format("{n}", &.{ n: run B.uint(run B.field(config, "width")) })
  let height = run B.format("{n}", &.{ n: run B.uint(run B.field(config, "height")) })
  run document.setAttribute(root, "", "width", String.view(&width))
  run document.setAttribute(root, "", "height", String.view(&height))
  let mut names = List<Namespace>.make()
  let nodes = document.nodes()
  let mut i: usize = 0
  while i < nodes.length {
    let id = XmlNodeId { index: i }
    if document.kind(id) == XmlNodeKind.Element {
      run register(&mut names, document.namespaceUri(id))
      let attributes = document.attributes(id)
      let mut a: usize = 0
      while a < attributes.length {
        run register(&mut names, document.attributeNamespaceUri(attributes[a]))
        a = a + 1
      }
    }
    i = i + 1
  }
  let mut text = run String.copy("<?xml version='1.0' encoding='utf-8'?>\n")
  run serialize(&document, root, names.asSlice(), true, &mut text)
  return String.intoBytes(move text)
}

pub effect fn verifyAsset(data: &[u8], spec: &Value) -> ()
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let digest = run B.hash(data)
  if String.view(&digest) != run B.str(run B.field(spec, "sha256")) {
    run Task.abort("Tiger SHA-256 mismatch; refusing unpinned content")
  }
  if usize.toU64(data.length) != run B.uint(run B.field(spec, "bytes")) {
    run Task.abort("Tiger byte count mismatch")
  }
}

fn lengthHash(hash: &mut Sha256, value: usize) -> () {
  let mut n = usize.toU64(value)
  let mut bytes: [u8; 8] = [0; 8]
  let mut i: usize = 8
  while i > 0 {
    i = i - 1
    bytes[i] = u64.toU8(n & 255)
    n = u64.shiftRight(n, 8)
  }
  hash.update(&bytes)
}

pub effect fn workloadHash(files: &[Path]) -> String
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  // Preparation and directory listings supply filename-sorted files.
  let mut order = List<usize>.make()
  let mut i: usize = 0
  while i < files.length {
    run order.append(i)
    i = i + 1
  }
  i = 1
  while i < order.length() {
    let mut j = i
    while j > 0
      && B.before(
        run B.name(&files[order.asSlice()[j]]),
        run B.name(&files[order.asSlice()[j - 1]]),
      ) {
      let previous = order.asSlice()[j - 1]
      let current = order.asSlice()[j]
      order.set(j - 1, current)
      order.set(j, previous)
      j = j - 1
    }
    i = i + 1
  }
  let mut digest = Sha256.make()
  i = 0
  while i < order.length() {
    let file = &files[order.asSlice()[i]]
    let name = String.utf8Bytes(run B.name(file))
    let data = run FileSystem.readFile(file)
    lengthHash(&mut digest, name.length)
    digest.update(name)
    lengthHash(&mut digest, data.length())
    digest.update(data.asSlice())
    i = i + 1
  }
  let hash = digest.finish()
  return run B.hex(&hash)
}

pub effect fn prepare(
  manifest: &Value,
  cache: &Path,
  fetchTiger: bool,
  selected: &[String],
) -> List<Workload>
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let specs = run B.entries(run B.field(manifest, "workloads"))
  let mut workloads = List<Workload>.make()
  let mut i: usize = 0
  while i < specs.length {
    let name = String.view(&specs[i].key)
    let spec = &specs[i].value
    i = i + 1
    if selected.length > 0 && !B.selected(selected, name) {
      continue
    }
    let directory = run Path.join(cache, name)
    run FileSystem.createDirectoriesRecursively(&directory)
    let mut files = List<Path>.make()
    let mut bytes: usize = 0
    if name == "tiger" {
      let original = run Path.join(&directory, "tiger.svg")
      if !run FileSystem.exists(&original) {
        if !fetchTiger {
          run Task.abort(
            "pinned Tiger is missing; run workloads --fetch-tiger (AGPL-3.0-or-later benchmark-only asset)",
          )
        }
        let maximum = run B.format("{n}", &.{ n: run B.uint(run B.field(spec, "bytes")) })
        let downloaded = run Process.execute(
          "curl",
          &[
            "--fail",
            "--location",
            "--proto",
            "=https",
            "--proto-redir",
            "=https",
            "--max-time",
            "60",
            "--max-filesize",
            String.view(&maximum),
            "--user-agent",
            "silk-svg-bench/0.1",
            run B.str(run B.field(spec, "url")),
          ],
          65.0,
          false,
        )
        run verifyAsset(downloaded.output.asSlice(), spec)
        run FileSystem.writeFile(&original, downloaded.output.asSlice())
      }
      let source = run FileSystem.readFile(&original)
      run verifyAsset(source.asSlice(), spec)
      let normalization = run B.field(spec, "viewport_normalization")
      let normalized = run normalizeTiger(source.asSlice(), normalization)
      run verifyAsset(normalized.asSlice(), normalization)
      let derived = run Path.join(&directory, "tiger-sized.svg")
      run B.replaceChanged(&derived, normalized.asSlice())
      let mut provenance = run Json.copy(spec)
      run B.set(&mut provenance, "source_file", run B.stringValue("tiger.svg"))
      run B.set(&mut provenance, "benchmark_file", run B.stringValue("tiger-sized.svg"))
      run B.set(
        &mut provenance,
        "derived_sha256",
        run Json.copy(run B.field(normalization, "sha256")),
      )
      run B.set(&mut provenance, "derived_bytes", B.integer(usize.toU64(normalized.length())))
      let encoded = run B.encoded(&provenance)
      let provenanceFile = run Path.join(&directory, "provenance.json")
      run FileSystem.writeFile(&provenanceFile, encoded.asSlice())
      bytes = normalized.length()
      run files.append(move derived)
    } else {
      let generated = run Geometry.generate(name, run B.field(spec, "config"))
      let generatedFiles = generated.asSlice()
      let mut j: usize = 0
      while j < generatedFiles.length {
        let file = run Path.join(&directory, String.view(&generatedFiles[j].name))
        let text = String.utf8Bytes(String.view(&generatedFiles[j].text))
        run B.replaceChanged(&file, text)
        bytes = bytes + text.length
        run files.append(move file)
        j = j + 1
      }
    }
    let hash = run workloadHash(files.asSlice())
    run workloads.append(
      Workload { name: run String.copy(name), files: move files, bytes: bytes, sha256: move hash },
    )
  }
  return move workloads
}
