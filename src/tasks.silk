import bench { BenchCommands }
import bench as Bench
import corpora { CorpusFailure }
import corpora as Corpus
import corpora_tasks { CorporaCommands }
import corpora_tasks as Corpora
import fixtures as Fixtures
import gate as Gate
import idna as Idna
import task_support as Support
import wasm_parity as WasmParity
import xmlconf as Xmlconf
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

union Tasks {
  Check { pub offline: bool, pub skipFetch: bool },
  TestGpu { pub suites: List<String> },
  CheckWasm,
  CheckXmlconf { pub offline: bool, pub report: String },
  Conformance { pub offline: bool },
  BuildWasm,
  GenerateIdna { pub fetch: bool, pub update: bool, pub check: bool },
  Fixtures { pub name: String },
  Benchmarks { pub benchmarkCommand: BenchCommands },
  Corpora { pub corpusCommand: CorporaCommands },
  SetupCi { pub linuxGpu: bool },
  TestTooling,
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "SVG repository automation")
      |> Command.variant("Check", "Check packages, tests and reviewed rendering corpus")
      |> Command.variant("TestGpu", "Compare native GPU and CPU rendering")
      |> Command.variant("CheckWasm", "Compare JavaScript-hosted wasm and native RGBA output")
      |> Command.variant("CheckXmlconf", "Run the authenticated W3C XML conformance suite")
      |> Command.variant("Conformance", "Run complete SVG and XML conformance suites")
      |> Command.variant("BuildWasm", "Build the release wasm module and print its path")
      |> Command.variant("GenerateIdna", "Regenerate or verify the locked Unicode IDNA tables")
      |> Command.variant("Fixtures", "Explicitly regenerate original fixture assets")
      |> Command.variant("Benchmarks", "Benchmark setup, measurement and workload generators")
      |> Command.variant("Corpora", "Specification and suite fetching, reftest execution")
      |> Command.variant("SetupCi", "Provision native CI tooling through lib-native tasks")
      |> Command.variant("TestTooling", "Run Silk tooling regression tests")
      |> Command.option("offline", Opt.about("Verify cached external inputs without downloading"))
      |> Command.option("skipFetch", Opt.about("Skip external references and IDNA verification"))
      |> Command.option("report", Opt.about("Write XML JSON report") |> Opt.default(""))
      |> Command.option("fetch", Opt.about("Fetch missing pinned IDNA sources"))
      |> Command.option("update", Opt.about("Explicitly refresh reviewed IDNA source pins"))
      |> Command.option("check", Opt.about("Verify generated IDNA bytes without source edits"))
      |> Command.option("linuxGpu", Opt.about("Provision the Linux software GPU backend"))
      |> Command.arg("suites", Opt.about("Fixture suites; omitted means all suites"))
      |> Command.arg("name", Opt.about("Fixture generator name, or all") |> Opt.required)
      |> Command.subcommand("benchmarkCommand")
      |> Command.subcommand("corpusCommand")
  }
}

effect fn fixtureFailure<E>(error: E) -> ()
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  drop error
  run Task.abort("Fixture generation failed; committed assets are not regenerated by normal checks")
}

effect fn corpusFailure(error: CorpusFailure) -> ()
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let message = run Corpus.errorMessage(move error)
  run Task.abort(String.view(&message))
}

effect fn svgConformance(offline: bool) -> bool
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  run Effect.catchAll(Corpora.conformance(offline), corpusFailure)
  return true
}

effect fn xmlConformance(offline: bool) -> bool
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  run Xmlconf.check(offline, "build/svg-conformance/xmlconf.json")
  return true
}

effect fn conformanceFailure<E>(error: E) -> bool
  ! WriterError {
  drop error
  run Support.printLine("Conformance subgate failed; other suites still run")
  return false
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Check { offline, skipFetch } => {
        if !skipFetch {
          run Idna.generate(!offline, false, true)
        }
        run Gate.workspace()
        run Effect.catchAll(Corpora.gate(offline, skipFetch), corpusFailure)
      }
      Tasks.TestGpu { suites } => run Gate.gpu(&suites)
      Tasks.CheckWasm => run WasmParity.check()
      Tasks.CheckXmlconf { offline, report } => run Xmlconf.check(offline, String.view(&report))
      Tasks.Conformance { offline } => {
        let svg = run Effect.catchAll(svgConformance(offline), conformanceFailure)
        let xml = run Effect.catchAll(xmlConformance(offline), conformanceFailure)
        if !svg || !xml {
          run Task.abort("One or more conformance suites failed")
        }
      }
      Tasks.BuildWasm => {
        let module = run Support.build("modules/tools/wasm", "svg-wasm", true, true)
        run Support.printLine(String.view(&module))
      }
      Tasks.GenerateIdna { fetch, update, check } => run Idna.generate(fetch, update, check)
      Tasks.Fixtures { name } => {
        let root = run Task.root()
        run Effect.catchAll(Fixtures.generate(&root, String.view(&name)), fixtureFailure)
      }
      Tasks.Benchmarks { benchmarkCommand } => run Bench.perform(move benchmarkCommand)
      Tasks.Corpora { corpusCommand } => run Effect.catchAll(
        Corpora.perform(move corpusCommand),
        corpusFailure,
      )
      Tasks.SetupCi { linuxGpu } => run Gate.setupCi(linuxGpu)
      Tasks.TestTooling => run Task.silk(
        &["test", "--manifest-path", "silk.toml", "--root", "src/tests.silk"],
      )
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
