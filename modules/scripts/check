#!/usr/bin/env node
import { existsSync, mkdirSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { build, root, run, silk } from '../../scripts/internal.mjs';

const options = new Set(process.argv.slice(2));
for (const option of options) if (!['--offline', '--skip-fetch'].includes(option)) throw new Error(`Unknown option: ${option}`);
const workspace = readFileSync(resolve(root, 'silk.toml'), 'utf8').match(/members\s*=\s*\[([\s\S]*?)\]/)[1];
const packages = [...workspace.matchAll(/"([^"]+)"/g)].map(match => match[1]);
if (!options.has('--skip-fetch')) run(process.execPath, ['modules/scripts/generate-idna', '--check', ...(options.has('--offline') ? [] : ['--fetch'])]);
// Serial compilation and first fetch avoid overlapping immutable Git checkout materialization.
for (const path of packages) run(silk, ['check', '--manifest-path', `${path}/silk.toml`]);
for (const path of packages) run(silk, ['format', '--check', '--manifest-path', `${path}/silk.toml`]);
for (const path of packages) if (existsSync(resolve(root, path, 'src/tests.silk'))) run(silk, ['test', '--manifest-path', `${path}/silk.toml`, '--root', 'src/tests.silk']);
run(process.execPath, ['scripts/test-tooling.mjs']);
const binary = build('svg-render-test-harness', { release: true });
run(binary, ['--help']);
run(binary, ['--version']);
mkdirSync(resolve(root, 'build/svg'), { recursive: true });
const renderer = [binary, '{input}', '-o', '{output}', '--font-dir', 'modules/tests/fonts'];
for (const name of ['own', 'css', 'structure', 'clip-shapes', 'masking', 'clipping', 'compositing', 'painting', 'images', 'filters', 'text', 'animation', 'color', 'malformed']) {
  run(process.execPath, ['modules/scripts/reftests', '--suite', 'own', '--manifest', `modules/tests/fixtures/${name}/manifest.json`, ...(name === 'malformed' ? ['--malformed'] : []), '--renderer', JSON.stringify(renderer), '--report', `build/svg/${name}.json`, '--diff-dir', `build/svg/${name}-diffs`]);
}
if (!options.has('--skip-fetch')) {
  const offline = options.has('--offline') ? ['--offline'] : [];
  run(process.execPath, ['modules/scripts/fetch-specs.mjs', '--only', 'svg2-coords', 'svg2-paths', 'svg2-conform', 'fetch', 'infra', ...offline]);
  run(process.execPath, ['modules/scripts/fetch-suites', ...offline]);
  run(process.execPath, ['modules/scripts/reftests', '--renderer', JSON.stringify([...renderer, '--width', '300']), '--report', 'build/svg/resvg-curated.json', '--diff-dir', 'build/svg/resvg-curated-diffs']);
}
console.log('SVG rendering gate passed.' + (options.has('--skip-fetch') ? ' External references skipped by request.' : ''));
